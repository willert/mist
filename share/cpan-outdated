  sub _init {
      my ($class, $uri, $scheme) = @_;
  
      my $self = $class->SUPER::_init($uri, $scheme);
  
      # Normalise at poles.
      my $lat = $self->latitude;
      if ($lat == _MAXIMUM_LATITUDE() || $lat == _MINIMUM_LATITUDE()) {
          $self->longitude(0);
      }
      return $self;
